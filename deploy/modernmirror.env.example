# ModernMirror 环境变量示例
# 复制到 /etc/modernmirror/modernmirror.env 后按需修改

MODERNMIRROR_DATA=/var/lib/modernmirror
MODERNMIRROR_HOST=127.0.0.1
MODERNMIRROR_PORT=8800

# 必填，使用强随机值
MODERNMIRROR_TOKEN=replace-with-a-long-random-token

# 首次初始化后即可删除以下两项
# MODERNMIRROR_ADMIN_USER=admin
# MODERNMIRROR_ADMIN_PASSWORD=replace-with-a-strong-password

MODERNMIRROR_MAX_MB=2048
MODERNMIRROR_MAX_UPLOAD_MB=2048
MODERNMIRROR_RATE_LIMIT=600

# 使用只读代码目录时避免生成字节码
PYTHONDONTWRITEBYTECODE=1
