[Unit]
Description=ModernMirror package cache service
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=modernmirror
Group=modernmirror
WorkingDirectory=/opt/ModernMirror/backend
EnvironmentFile=/etc/modernmirror/modernmirror.env
ExecStart=/opt/ModernMirror/backend/venv/bin/python -m app.main
Restart=on-failure
RestartSec=3
TimeoutStopSec=20

# 基础加固
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/lib/modernmirror

[Install]
WantedBy=multi-user.target
